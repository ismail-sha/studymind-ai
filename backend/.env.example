# ── Backend Environment Variables ──────────────────────────────
# Copy this file to  .env  and fill in your values

# PostgreSQL connection string (from Render)
DATABASE_URL=postgresql://user:password@host:5432/studymind

# JWT secret — use a long random string (min 32 chars)
JWT_SECRET=change_this_to_a_very_long_random_secret_string_here

# Your email — this account gets admin role automatically
ADMIN_EMAIL=your_email@gmail.com

# Frontend URL for CORS (your Netlify URL after deploy)
FRONTEND_URL=https://your-app-name.netlify.app

# Environment
NODE_ENV=production

# Port (Render sets this automatically)
PORT=5000
